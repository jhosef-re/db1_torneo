---
import Base from '../layouts/Base.astro';
---

<Base title="Error del servidor · Campeonato 2026">
  <h1 class="mb-2 text-2xl font-semibold">500 · Error del servidor</h1>
  <p class="text-slate-600">
    La base de datos no está disponible en este momento. Inténtalo de nuevo en unos minutos.
  </p>
  <p class="mt-3 text-sm text-slate-500">
    Si necesitas acceso inmediato, puedes revisar la base con las
    <code>sql/*.sql</code> del proyecto principal.
  </p>
  <p class="mt-3"><a href="/" class="text-sky-700 hover:underline">Volver a posiciones</a></p>
</Base>
