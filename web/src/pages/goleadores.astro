---
import Base from '../layouts/Base.astro';
import { goleadores } from '../lib/queries/goleadores';

const datos = await goleadores();
const totalGoles = datos.reduce((s, d) => s + d.goles, 0);
---

<Base title="Goleadores · Campeonato 2026">
  <h1 class="mb-1 text-2xl font-semibold">Goleadores</h1>
  <p class="mb-3 text-sm text-slate-500">{datos.length} jugadores · Σ goles = {totalGoles}</p>

  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="w-full text-sm">
      <thead class="bg-slate-100 text-left text-slate-700">
        <tr>
          <th class="px-3 py-2 w-16">#</th>
          <th class="px-3 py-2">Jugador</th>
          <th class="px-3 py-2">Equipo</th>
          <th class="px-3 py-2 text-right">Goles</th>
        </tr>
      </thead>
      <tbody>
        {datos.map((g, i) => (
          <tr class="border-t border-slate-100 even:bg-slate-50">
            <td class="px-3 py-2 text-slate-500">{i + 1}</td>
            <td class="px-3 py-2">{g.nombre}</td>
            <td class="px-3 py-2">
              <a href={`/equipos/${g.equipo_id}`} class="text-sky-700 hover:underline">{g.equipo}</a>
            </td>
            <td class="px-3 py-2 text-right font-mono">{g.goles}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
