---
import Base from '../../layouts/Base.astro';
import { partidoDetalle } from '../../lib/queries/partido';
import { etiquetaMarcador, fechaCorta } from '../../lib/formato';

const { id } = Astro.params;
const numeric = id !== undefined && /^[1-9][0-9]*$/.test(id) ? Number(id) : null;

let detalle = null as Awaited<ReturnType<typeof partidoDetalle>>;
let notFound = false;

if (numeric === null) {
  notFound = true;
} else {
  detalle = await partidoDetalle(numeric);
  if (detalle === null) notFound = true;
}

// RP-07: 404 con página genérica.
if (notFound) {
  Astro.response.status = 404;
}
---

{
  notFound && (
    <Base title="Partido no encontrado · Campeonato 2026">
      <h1 class="mb-2 text-2xl font-semibold">Partido no encontrado</h1>
      <p class="text-slate-600">El id de partido solicitado no existe o no es válido.</p>
      <p class="mt-3"><a href="/calendario" class="text-sky-700 hover:underline">Volver al calendario</a></p>
    </Base>
  )
}

{
  !notFound && detalle && (
    <Base title={`Jornada ${detalle.jornada} · ${detalle.local.nombre} vs ${detalle.visitante.nombre}`}>
      <nav class="mb-3 text-sm text-slate-500">
        <a href="/" class="hover:underline">Posiciones</a>
        <span class="mx-1">›</span>
        <a href="/calendario" class="hover:underline">Calendario</a>
        <span class="mx-1">›</span>
        <span>Jornada {detalle.jornada}</span>
      </nav>

      <header class="mb-4">
        <p class="text-sm text-slate-500">Jornada {detalle.jornada} · {fechaCorta(detalle.fecha)} · {detalle.hora}</p>
        <h1 class="mt-1 text-2xl font-semibold">
          <a href={`/equipos/${detalle.local.equipo_id}`} class="text-sky-700 hover:underline">{detalle.local.nombre}</a>
          <span class="mx-3 text-slate-400">vs</span>
          <a href={`/equipos/${detalle.visitante.equipo_id}`} class="text-sky-700 hover:underline">{detalle.visitante.nombre}</a>
        </h1>
        <p class="mt-1 text-slate-600">
          Estadio {detalle.estadio.nombre} · {detalle.estadio.ubicacion} · cap. {detalle.estadio.capacidad.toLocaleString('es-GT')}
        </p>
      </header>

      <section class="mb-6 rounded-lg border border-slate-200 bg-white p-4">
        <h2 class="mb-2 text-lg font-semibold">Resultado</h2>
        {detalle.resultado === null ? (
          <p class="text-lg font-medium text-amber-700">Pendiente</p>
        ) : (
          <p class="font-mono text-2xl">
            {detalle.local.nombre} <span class="text-slate-500 mx-2">{etiquetaMarcador(detalle.resultado)}</span> {detalle.visitante.nombre}
          </p>
        )}
      </section>

      <section class="mb-6">
        <h2 class="mb-2 text-lg font-semibold">Árbitros</h2>
        <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
          <table class="w-full text-sm">
            <thead class="bg-slate-100 text-left text-slate-700">
              <tr>
                <th class="px-3 py-2 w-24">Rol</th>
                <th class="px-3 py-2">Nombre</th>
                <th class="px-3 py-2 w-24">Código</th>
              </tr>
            </thead>
            <tbody>
              {detalle.arbitros.map((a) => (
                <tr class="border-t border-slate-100">
                  <td class="px-3 py-2 font-mono">{a.rol}</td>
                  <td class="px-3 py-2">{a.nombre}</td>
                  <td class="px-3 py-2 font-mono">{a.codigo}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {detalle.estado === 'jugado' && (
        <section>
          <h2 class="mb-2 text-lg font-semibold">Goles</h2>
          {detalle.goles.length === 0 ? (
            <p class="text-slate-600">0–0 sin goles registrados (marcador contabilizado).</p>
          ) : (
            <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
              <table class="w-full text-sm">
                <thead class="bg-slate-100 text-left text-slate-700">
                  <tr>
                    <th class="px-3 py-2 w-20">Minuto</th>
                    <th class="px-3 py-2">Autor</th>
                  </tr>
                </thead>
                <tbody>
                  {detalle.goles.map((g) => (
                    <tr class="border-t border-slate-100">
                      <td class="px-3 py-2 font-mono text-slate-700">{g.minuto ?? '–'}</td>
                      <td class="px-3 py-2">
                        <a href={`/equipos/${g.equipo_id}`} class="text-sky-700 hover:underline">
                          {g.jugador.nombre}
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      )}
    </Base>
  )
}
