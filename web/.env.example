# =============================================================================
# Variables de entorno de la App Web del Campeonato.
# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA se versiona el archivo .env (ver .gitignore).
#
# Cumple: A5  (credenciales solo en el servidor, fuera del repo).
# =============================================================================

# Conexión que usa la app en runtime. Solo lectura.
#   - Usuario dedicado 'app_campeonato' con permisos SELECT sobre
#     campeonato_futbol.* (creado en sql/05_usuario_app.sql).
#   - Host 127.0.0.1 (no 'localhost') para evitar resolución IPv6.
DATABASE_URL=mysql://app_campeonato:<tu-clave>@127.0.0.1:3306/campeonato_futbol

# Conexión administrativa. Solo se usa para `drizzle-kit pull` (Fase A3, TA3.3).
# NO la use la app en runtime.
DATABASE_URL_ADMIN=mysql://root:<clave-admin>@127.0.0.1:3306/campeonato_futbol
